# Copy this file to .env and replace the placeholders before starting Compose.
# Host port for the API (container port is always 8080).
APP_PORT=8080

# External PostgreSQL / Supabase connection settings.
# Use the session pooler credentials shown in your Supabase connection settings.
DB_URL=jdbc:postgresql://YOUR_DB_HOST:5432/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD

# update creates/updates tables for the lab; validate requires an existing schema.
DB_DDL_AUTO=update
